{
  "name": "@micracode/desktop",
  "version": "0.1.4",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "bun --filter @micracode/core build && tsc && electron dist/main.js --no-sandbox",
    "dev:watch": "bun --filter @micracode/core build && tsc && (tsc -w & electronmon dist/main.js --no-sandbox)",
    "build": "bun --filter @micracode/core build && tsc && electron-builder --config electron-builder.config.js",
    "release": "bun --filter @micracode/core build && tsc && electron-builder --mac --config electron-builder.config.js",
    "release:publish": "bun --filter @micracode/core build && tsc && electron-builder --mac --publish always --config electron-builder.config.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@micracode/core": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electronmon": "^2.0.4",
    "typescript": "^5.6.3"
  }
}
