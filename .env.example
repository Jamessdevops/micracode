# ============================================================
# Micracode — env template
# Copy to `.env` at the repo root (read by @micracode/core in dev).
# In the packaged desktop app, keys are entered in the UI and
# persisted to a shared auth file instead.
#
# The Next.js app picks up NEXT_PUBLIC_* vars at build/dev time;
# no database or auth credentials required.
# ============================================================

# ---------- Next.js (apps/web) ----------
# Base URL of the core backend. In dev, @micracode/core listens on 8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------- Core backend (@micracode/core) ----------
# Provide a key for the provider you want; the model picker shows
# whichever providers have a key set. At least one is required.
OPENAI_API_KEY=replace-with-your-openai-api-key
GOOGLE_API_KEY=replace-with-your-gemini-api-key

# Port the core backend binds in dev (default 8000).
# PORT=8000

# Where generated projects live on disk. Defaults to ~/opener-apps.
# OPENER_APPS_DIR=/absolute/path/to/opener-apps
